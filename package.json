{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "flashcards",
  "title": "Flashcards",
  "description": "Karteikarten schnell erstellen und lernen mit Markdown-Syntax",
  "icon": "extension-icon.png",
  "author": "Paul12169",
  "categories": ["Productivity", "Other"],
  "license": "MIT",
  "commands": [
    {
      "name": "create-card",
      "title": "Erstellen",
      "subtitle": "Flashcards",
      "description": "Neue Karteikarte mit Markdown anlegen",
      "mode": "view"
    },
    {
      "name": "list-cards",
      "title": "Liste",
      "subtitle": "Flashcards",
      "description": "Alle Karteikarten anzeigen",
      "mode": "view"
    },
    {
      "name": "tags",
      "title": "Tags",
      "subtitle": "Flashcards",
      "description": "Karteikarten nach Tags durchsuchen",
      "mode": "view"
    },
    {
      "name": "quiz",
      "title": "Quiz",
      "subtitle": "Flashcards",
      "description": "Karteikarten abfragen",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "language",
      "title": "Sprache / Language",
      "description": "Sprache der Extension (betrifft die Syntax für richtig/true)",
      "type": "dropdown",
      "required": false,
      "default": "de",
      "data": [
        { "title": "Deutsch", "value": "de" },
        { "title": "English", "value": "en" }
      ]
    }
  ],
  "overrides": {
    "minimatch": "^9.0.7"
  },
  "dependencies": {
    "@raycast/api": "^1.70.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "^20.8.10",
    "@types/react": "^18.2.27",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
